QWidget { background: @background; color: @text; font-family: 'Segoe UI'; }
QPushButton#musicCard { background: @surface; border: 1px solid @border; border-radius: 12px; padding: 0; }
QPushButton#musicCard:hover { background: @selected; border-color: @violet; }
QPushButton#musicCard:focus { border: 2px solid @cyan; }
QLabel#musicCover { background: @selected; border-radius: 10px; font-size: 36px; color: @cyan; }
QDialog#queuePanel { background: @sidebar; border-left: 1px solid @border; }
QSplitter::handle { background: @border; width: 1px; }
QFrame#sidebar, QFrame#playback { background: @sidebar; }
QFrame#sidebar { border-right: 1px solid @border; }
QFrame#playback { border-top: 1px solid @border; }
QFrame#card { background: @surface; border: 1px solid @border; border-radius: 16px; }
QPushButton#card { background: @surface; border: 1px solid @border; border-radius: 16px; }
QPushButton#card:hover, QPushButton#card:focus { border-color: @violet; }
QPushButton#artworkPlaceholder { background: @selected; border: none; border-radius: 12px; font-size: 18px; }
QFrame#hero { background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 @selected,stop:1 @surface); border-radius: 20px; }
QLabel { background: transparent; }
QLabel#title { font-size: 30px; font-weight: 700; }
QLabel#subtitle { color: @muted; font-size: 13px; }
QLabel#eyebrow { color: @cyan; font-size: 11px; font-weight: 600; }
QLabel#brand { font-size: 20px; font-weight: 700; }
QLabel#section { font-size: 18px; font-weight: 600; }
QPushButton { background: @surface; border: 1px solid @border; border-radius: 8px; padding: 10px 16px; }
QPushButton:hover { border-color: @violet; }
QPushButton:focus { border: 2px solid @cyan; }
QPushButton:disabled { color: @muted; background: @surface; }
QPushButton#nav { text-align: left; background: transparent; border: none; padding: 11px 16px; }
QPushButton#nav:checked { background: @selected; color: @violet; border-left: 3px solid @violet; }
QPushButton#nav:hover { background: @surface; }
QPushButton#primary { background: @violet; color: @text; font-weight: 600; }
QSlider::groove:horizontal { height: 4px; background: @border; border-radius: 2px; }
QSlider::handle:horizontal { background: @muted; width: 10px; margin: -3px 0; border-radius: 5px; }
QCheckBox { spacing: 12px; background: transparent; }
QCheckBox::indicator { width: 18px; height: 18px; border: 1px solid @muted; border-radius: 4px; }
QCheckBox::indicator:checked { background: @violet; border-color: @violet; }
QScrollArea { border: none; }
QScrollBar:vertical { background: @background; width: 8px; }
QScrollBar::handle:vertical { background: @border; border-radius: 4px; min-height: 30px; }
QScrollBar:horizontal { background: @background; height: 7px; }
QScrollBar::handle:horizontal { background: @border; border-radius: 3px; min-width: 32px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }
QToolTip { background: @surface; color: @text; border: 1px solid @border; padding: 6px; }
QLineEdit { background: @surface; color: @muted; border: none; border-radius: 14px; padding: 14px; }
QFrame#artworkPlaceholder { background: @selected; border-radius: 12px; }
QToolButton { background: @surface; border: 1px solid @border; border-radius: 6px; padding: 6px; }
QToolButton:disabled { color: @muted; }
QToolButton:checked, QPushButton:checked { border-color: @violet; }
QToolButton:focus { border-color: @cyan; }
QMenuBar, QMenu { background: @sidebar; color: @text; }
QMenu::item:selected { background: @selected; }
QTableView { background: @background; alternate-background-color: @sidebar; border: 1px solid @border; gridline-color: @border; selection-background-color: @selected; }
QHeaderView::section { background: @surface; color: @muted; padding: 12px; border: none; }
QTableView::item { padding: 10px; }
QPushButton#primary:disabled { background: @surface; color: @muted; }
QListWidget { background: @sidebar; border: 1px solid @border; border-radius: 10px; padding: 8px; }
QListWidget::item { padding: 14px 8px; }
QListWidget::item:selected { background: @selected; color: @text; border-radius: 6px; }

/* Light rose surfaces and crisp outlines, shared by every desktop page. */
QPushButton { border: 2px solid @border; border-radius: 9px; }
QPushButton#nav:checked { background: @surface; color: @text; border: 2px solid @border; font-weight: 700; }
QPushButton#primary { background: @surface; color: @text; border: 2px solid @border; padding: 4px; }
QPushButton#transport { background: @sidebar; border: none; padding: 3px; font-size: 24px; }
QPushButton#transport:hover, QPushButton#transport:checked, QPushButton#transport[active="true"] { background: @selected; border: 1px solid @border; }
QToolButton#playerFavorite { background: transparent; border: none; color: @cyan; font-size: 25px; }
QLineEdit { background: @sidebar; color: @text; border: 2px solid @border; border-radius: 9px; padding: 9px 12px; }
QTableView { background: @sidebar; alternate-background-color: @sidebar; border: 2px solid @border; }
QHeaderView::section { color: @text; font-weight: 600; padding: 9px; border-bottom: 1px solid @border; }
QListWidget#playlistGallery { background: transparent; border: none; padding: 0; }
QListWidget#playlistGallery::item { background: @surface; border: 2px solid @border; border-radius: 9px; padding: 8px; }
QListWidget#playlistGallery::item:selected { background: @selected; border: 3px solid @border; }
QListWidget#playlistGallery::item:hover { background: @selected; }
QSlider::groove:horizontal { background: @selected; border: 1px solid @border; height: 8px; border-radius: 4px; }
QSlider::sub-page:horizontal { background: @surface; border-radius: 4px; }
QSlider::handle:horizontal { background: @sidebar; border: 1px solid @border; width: 13px; margin: -3px 0; border-radius: 7px; }
QSlider#playerProgress::groove:horizontal { height: 8px; border-radius: 0; border: none; background: @selected; }
QSlider#playerProgress::sub-page:horizontal { background: @surface; border-radius: 0; }
QSlider#playerProgress::handle:horizontal { background: @cyan; width: 3px; border: none; margin: 0; border-radius: 0; }

